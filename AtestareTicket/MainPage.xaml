<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AtestareTicket.MainPage"
             BackgroundColor="#F2F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,40" Spacing="0">

            <!-- ═══ TOP INFO BAR (like website top bar) ═══ -->
            <Grid BackgroundColor="#F5F6F7"
                  Padding="20,6">
                <Label Text="Universitatea Tehnică a Moldovei"
                       FontSize="11"
                       TextColor="#555E6B"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"/>
                <Label Text="fcim.utm.md"
                       FontSize="11"
                       TextColor="#2E6DA4"
                       HorizontalOptions="End"
                       VerticalOptions="Center"/>
            </Grid>

            <!-- ═══ WHITE NAV BAR with logo (matches website header) ═══ -->
            <Frame BackgroundColor="White"
                   CornerRadius="0"
                   Padding="24,16"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Logo -->
                    <Image Source="fcim_logo.png"
                           HeightRequest="52"
                           WidthRequest="210"
                           Aspect="AspectFit"
                           HorizontalOptions="Start"
                           VerticalOptions="Center"
                           Grid.Column="0"/>
                    <!-- Nav button matching website "Orarul" style -->
                    <Frame BackgroundColor="#0D2B5E"
                           CornerRadius="4"
                           Padding="14,8"
                           HasShadow="False"
                           VerticalOptions="Center"
                           HorizontalOptions="End"
                           Grid.Column="1">
                        <Label Text="Bilete Atestare"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center"/>
                    </Frame>
                </Grid>
            </Frame>

            <!-- ═══ NAVY HERO BAND (matches website dark blue hero) ═══ -->
            <Frame BackgroundColor="#0D2B5E"
                   CornerRadius="0"
                   Padding="28,28,28,24"
                   HasShadow="False"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="CREEAZĂ. DESCOPERĂ. INOVEAZĂ."
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"
                           CharacterSpacing="1"/>
                    <Label Text="Sistem de generare a biletelor de atestare · FCIM"
                           FontSize="13"
                           TextColor="#A8C4E0"
                           Margin="0,2,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- thin separator -->
            <BoxView HeightRequest="1" Color="#D8E4EF" Margin="0,0,0,28"/>

            <!-- ═══ CARD: GROUP ═══ -->
            <Frame BackgroundColor="White"
                   CornerRadius="6"
                   Padding="20,18"
                   HasShadow="True"
                   Margin="24,0,24,16">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <BoxView WidthRequest="4"
                                 HeightRequest="22"
                                 Color="#2E6DA4"
                                 CornerRadius="2"
                                 VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="PAS 1"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#2E6DA4"
                                   CharacterSpacing="1.5"/>
                            <Label Text="Grupul academic"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0D2B5E"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Frame Padding="4,0"
                           CornerRadius="4"
                           BorderColor="#C5D8F0"
                           BackgroundColor="#F4F8FD"
                           HasShadow="False">
                        <Picker x:Name="GroupPicker"
                                Title="— Selectați grupul —"
                                FontSize="15"
                                TextColor="#1A2E4A"
                                TitleColor="#95A5A6"
                                Margin="6,2"
                                SelectedIndexChanged="OnGroupSelected"/>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- ═══ CARD: NAME ═══ -->
            <Frame BackgroundColor="White"
                   CornerRadius="6"
                   Padding="20,18"
                   HasShadow="True"
                   Margin="24,0,24,28">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <BoxView WidthRequest="4"
                                 HeightRequest="22"
                                 Color="#2E6DA4"
                                 CornerRadius="2"
                                 VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="PAS 2"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#2E6DA4"
                                   CharacterSpacing="1.5"/>
                            <Label Text="Numele studentului"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0D2B5E"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Frame Padding="4,0"
                           CornerRadius="4"
                           BorderColor="#C5D8F0"
                           BackgroundColor="#F4F8FD"
                           HasShadow="False">
                        <Picker x:Name="NamePicker"
                                Title="— Selectați numele —"
                                FontSize="15"
                                TextColor="#1A2E4A"
                                TitleColor="#95A5A6"
                                Margin="6,2"
                                SelectedIndexChanged="OnNameSelected"/>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- ═══ GENERATE BUTTON (matches website "Alege un program" button) ═══ -->
            <Button x:Name="GenerateButton"
                    Text="Generează Biletul"
                    IsEnabled="False"
                    Clicked="OnGenerateTicketClicked"
                    BackgroundColor="#0D2B5E"
                    TextColor="White"
                    FontSize="15"
                    FontAttributes="Bold"
                    CornerRadius="4"
                    HeightRequest="52"
                    Margin="24,0,24,0"
                    Shadow="{Shadow Brush='#400D2B5E', Offset='0,3', Radius='6'}"/>

            <!-- ═══ HINT ═══ -->
            <Label x:Name="HintLabel"
                   Text="Selectați grupul și numele pentru a genera biletul"
                   FontSize="12"
                   TextColor="#8A99AA"
                   HorizontalTextAlignment="Center"
                   Margin="24,12,24,0"/>

            <!-- ═══ FOOTER ═══ -->
            <VerticalStackLayout Spacing="2" Margin="0,36,0,0" HorizontalOptions="Center">
                <BoxView HeightRequest="1" Color="#D8E4EF" Margin="40,0"/>
                <Label Text="FCIM · UTM · fcim.utm.md"
                       FontSize="11"
                       TextColor="#555E6B"
                       HorizontalTextAlignment="Center"
                       Margin="0,10,0,0"/>
                <Label Text="str. Studenților 9/7, Chișinău, Republica Moldova"
                       FontSize="10"
                       TextColor="#AAB8C2"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
